<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Spendly - Modern Fintech Expense Tracker</display-name>

    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Encoding and Security Filter -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.spendly.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Authentication Session Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.spendly.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Auth Servlet -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.spendly.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Transaction Servlet -->
    <servlet>
        <servlet-name>TransactionServlet</servlet-name>
        <servlet-class>com.spendly.servlet.TransactionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TransactionServlet</servlet-name>
        <url-pattern>/api/transactions/*</url-pattern>
    </servlet-mapping>

    <!-- Category Servlet -->
    <servlet>
        <servlet-name>CategoryServlet</servlet-name>
        <servlet-class>com.spendly.servlet.CategoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CategoryServlet</servlet-name>
        <url-pattern>/api/categories/*</url-pattern>
    </servlet-mapping>

    <!-- Budget Servlet -->
    <servlet>
        <servlet-name>BudgetServlet</servlet-name>
        <servlet-class>com.spendly.servlet.BudgetServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BudgetServlet</servlet-name>
        <url-pattern>/api/budgets/*</url-pattern>
    </servlet-mapping>

    <!-- Savings Goal Servlet -->
    <servlet>
        <servlet-name>GoalServlet</servlet-name>
        <servlet-class>com.spendly.servlet.GoalServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoalServlet</servlet-name>
        <url-pattern>/api/goals/*</url-pattern>
    </servlet-mapping>

    <!-- Recurring Payment Servlet -->
    <servlet>
        <servlet-name>RecurringServlet</servlet-name>
        <servlet-class>com.spendly.servlet.RecurringServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecurringServlet</servlet-name>
        <url-pattern>/api/recurring/*</url-pattern>
    </servlet-mapping>

    <!-- Payment Accounts & UPI Demo Sync Servlet -->
    <servlet>
        <servlet-name>PaymentAccountServlet</servlet-name>
        <servlet-class>com.spendly.servlet.PaymentAccountServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentAccountServlet</servlet-name>
        <url-pattern>/api/accounts/*</url-pattern>
    </servlet-mapping>

    <!-- Analytics and Chart Data Servlet -->
    <servlet>
        <servlet-name>AnalyticsServlet</servlet-name>
        <servlet-class>com.spendly.servlet.AnalyticsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AnalyticsServlet</servlet-name>
        <url-pattern>/api/analytics/*</url-pattern>
    </servlet-mapping>

    <!-- Notification Servlet -->
    <servlet>
        <servlet-name>NotificationServlet</servlet-name>
        <servlet-class>com.spendly.servlet.NotificationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>NotificationServlet</servlet-name>
        <url-pattern>/api/notifications/*</url-pattern>
    </servlet-mapping>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>1440</session-timeout> <!-- 24 hours -->
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>
